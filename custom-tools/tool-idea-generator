              <div style={{ fontSize: 13, fontWeight: 700, color: COLORS.navy, marginBottom: 10, textTransform: "uppercase", letterSpacing: "0.04em" }}>Consider these prompts</div>
              <div style={{ display: "grid", gap: 8 }}>
                {(CHALLENGE_PROMPTS[data.priority] || []).map((q, i) => (
                  <div key={i} style={{ fontSize: 14, color: "#6B7280", lineHeight: 1.4, padding: "8px 12px", background: "#F8F9FB", borderRadius: 6, cursor: "pointer" }}
