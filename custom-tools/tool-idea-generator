        {/* STEP 0: Priority Area */}
        {step === 0 && (
          <div>
            <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "8px 0 6px" }}>Which high-impact area should we focus on?</h2>
            <p style={{ color: "#6B7280", fontSize: 15, marginBottom: 20, lineHeight: 1.5 }}>Where will increased innovation or efficiency move the needle most?</p>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: 12 }}>
              {PRIORITY_AREAS.map(p => (
                <Card key={p.id} selected={data.priority === p.id} onClick={() => update("priority", p.id)}>
