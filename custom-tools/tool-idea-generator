                    <div style={{ fontSize: 18, fontWeight: 800, marginBottom: 8 }}>{data.recommendations.tools.find(t => t.isRecommendedPilot)?.name}</div>
                    <div style={{ fontSize: 14, lineHeight: 1.6, opacity: 0.9 }}>{data.recommendations.pilotRationale}</div>
                  </div>
                )}

                {/* Tool cards */}
                {data.recommendations.tools.map((tool, i) => (
                  <div key={i} style={{ background: COLORS.white, borderRadius: 12, border: tool.isRecommendedPilot ? `2px solid ${COLORS.green}` : tool.isUserPick ? `2px solid ${COLORS.blue}` : "1px solid #E2E4E9", padding: 24, marginBottom: 16, position: "relative" }}>
                    {tool.isRecommendedPilot && (
                      <div style={{ position: "absolute", top: -1, right: 20, background: COLORS.green, color: COLORS.white, fontSize: 11, fontWeight: 700, padding: "4px 12px", borderRadius: "0 0 6px 6px", textTransform: "uppercase", letterSpacing: "0.05em" }}>Start here</div>
                    )}
                    {tool.isUserPick && (
                      <div style={{ position: "absolute", top: -1, right: 20, background: COLORS.blue, color: COLORS.white, fontSize: 11, fontWeight: 700, padding: "4px 12px", borderRadius: "0 0 6px 6px", textTransform: "uppercase", letterSpacing: "0.05em" }}>Your selection</div>
                    )}
                    <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 12 }}>
                      <div style={{ width: 32, height: 32, borderRadius: 8, background: tool.isUserPick ? COLORS.blue : [COLORS.green, COLORS.blue, COLORS.teal][i % 3], color: COLORS.white, display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, fontSize: 14 }}>{i + 1}</div>
                      <h3 style={{ color: COLORS.navy, fontSize: 18, fontWeight: 700, margin: 0 }}>{tool.name}</h3>
                      <span style={{ marginLeft: "auto", fontSize: 12, fontWeight: 600, padding: "3px 10px", borderRadius: 20, background: tool.pilotReadiness === "High" ? "#DCFCE7" : tool.pilotReadiness === "Medium" ? "#FEF3C7" : "#FEE2E2",
                        color: tool.pilotReadiness === "High" ? "#166534" : tool.pilotReadiness === "Medium" ? "#92400E" : "#991B1B" }}>{tool.pilotReadiness} readiness</span>
                    </div>
                    <p style={{ fontSize: 14, lineHeight: 1.6, color: COLORS.darkGray, marginBottom: 12 }}>{tool.description}</p>
                    <p style={{ fontSize: 13, lineHeight: 1.5, color: "#6B7280", marginBottom: 16, fontStyle: "italic" }}>{tool.whyFits}</p>

                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 16 }}>
                      <div>
                        <div style={{ fontSize: 12, fontWeight: 700, color: COLORS.navy, textTransform: "uppercase", letterSpacing: "0.04em", marginBottom: 8 }}>Input Fields</div>
                        {tool.fields.map((f, j) => (
                          <div key={j} style={{ fontSize: 13, marginBottom: 6, lineHeight: 1.4 }}>
                            <strong style={{ color: COLORS.navy }}>{f.name}:</strong> <span style={{ color: "#6B7280" }}>{f.description}</span>
                          </div>
                        ))}
                      </div>
                      <div>
                        <div style={{ fontSize: 12, fontWeight: 700, color: COLORS.navy, textTransform: "uppercase", letterSpacing: "0.04em", marginBottom: 8 }}>Knowledge Files</div>
                        {tool.knowledgeFiles.map((f, j) => (
                          <div key={j} style={{ fontSize: 13, color: "#6B7280", marginBottom: 4, paddingLeft: 12, position: "relative" }}>
                            <span style={{ position: "absolute", left: 0, color: COLORS.green }}>•</span>{f}
                          </div>
                        ))}
                        <div style={{ fontSize: 12, fontWeight: 700, color: COLORS.navy, textTransform: "uppercase", letterSpacing: "0.04em", marginBottom: 8, marginTop: 16 }}>Expected Output</div>
                        <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.5 }}>{tool.expectedOutput}</div>
                      </div>
                    </div>
                  </div>
                ))}

                {/* Export */}
                <div style={{ background: COLORS.white, borderRadius: 12, border: "1px solid #E2E4E9", padding: 24, textAlign: "center", marginTop: 24 }}>
                  <h3 style={{ color: COLORS.navy, fontSize: 17, fontWeight: 700, margin: "0 0 8px" }}>Export your planning summary</h3>
                  <p style={{ color: "#6B7280", fontSize: 14, marginBottom: 16 }}>Share this with your team, bring it to a planning meeting, or use it to start building in Solara.</p>
                  <div style={{ display: "flex", gap: 12, justifyContent: "center", flexWrap: "wrap" }}>
                    <Button onClick={copyToClipboard} variant={copySuccess ? "secondary" : "primary"}>
                      {copySuccess ? "✓ Copied to clipboard!" : "Copy Summary to Clipboard"}
                    </Button>
                  </div>
                </div>

                {/* Start over */}
                <div style={{ textAlign: "center", marginTop: 24 }}>
                  <Button variant="ghost" onClick={() => { setStep(-1); setData({ priority: null, challenge: "", users: [], hasExemplars: null, exemplarNotes: "", selectedTools: [], noneMatch: false, recommendations: null, isGenerating: false, genError: null }); }}>
                    ← Start a new session
                  </Button>
                </div>
              </div>
            )}
          </div>
        )}

        {/* Navigation */}
        {step >= 0 && step < 5 && (
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 32, paddingTop: 20, borderTop: "1px solid #E2E4E9" }}>
            <Button variant="ghost" onClick={() => setStep(s => s - 1)}>← Back</Button>
            <Button onClick={() => { if (step === 4) { setStep(5); } else { setStep(s => s + 1); } }} disabled={!canNext()}>
              {step === 4 ? "Review & Generate" : "Continue →"}
            </Button>
          </div>
        )}
      </div>

      <style>{`
        * { box-sizing: border-box; }
      `}</style>
    </div>
  );
}
