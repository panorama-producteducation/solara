export default function SolaraToolIdeaGenerator() {
  const [step, setStep] = useState(-1); // -1 = welcome
  const [data, setData] = useState({
    priority: null, challenge: "", users: [], hasExemplars: null, exemplarNotes: "",
    selectedTools: [], noneMatch: false, recommendations: null, isGenerating: false, genError: null,
  });
  const [copySuccess, setCopySuccess] = useState(false);
  const resultsRef = useRef(null);

  const update = (field, value) => setData(d => ({ ...d, [field]: value }));
  const canNext = () => {
    if (step === 0) return !!data.priority;
    if (step === 1) return data.challenge.trim().length > 20;
    if (step === 2) return data.users.length > 0;
    if (step === 3) return data.hasExemplars !== null;
    if (step === 4) return data.selectedTools.length > 0 || data.noneMatch;
    return true;
  };

  const filteredTools = TOOLS.filter(t => t.areas.includes(data.priority));
  const secondaryTools = TOOLS.filter(t => !t.areas.includes(data.priority) && data.users.some(u => t.users.includes(u))).slice(0, 4);

  const generateRecommendations = async () => {
    update("isGenerating", true);
    update("genError", null);
    const priorityLabel = PRIORITY_AREAS.find(p => p.id === data.priority)?.label || "";
    const userLabels = data.users.map(uid => USER_ROLES.find(u => u.id === uid)?.label).filter(Boolean);
    const selectedToolNames = data.selectedTools.map(id => TOOLS.find(t => t.id === id)?.name).filter(Boolean);
    const selectedToolObjects = data.selectedTools.map(id => TOOLS.find(t => t.id === id)).filter(Boolean);

    // If user selected example tools, we generate fewer new recs and append their picks
    const numUserPicks = Math.min(selectedToolObjects.length, 2);
    const numToGenerate = 3 - numUserPicks;

    const prompt = `You are a K-12 education technology specialist helping districts plan custom AI tools for Solara (an AI platform by Panorama Education).

Based on the following inputs from a district planning session, generate exactly ${numToGenerate} recommended custom tool concept${numToGenerate > 1 ? "s" : ""}. For each tool, provide a complete spec sheet that could be handed to someone to build the tool.

INPUTS:
- Priority Area: ${priorityLabel}
- Specific Challenge: ${data.challenge}
- Primary Audience: ${userLabels.join(", ")}
- Has Exemplars/Templates: ${data.hasExemplars ? "Yes" : "No"}${data.exemplarNotes ? ` (Notes: ${data.exemplarNotes})` : ""}
- Inspirational Tools Selected: ${selectedToolNames.length > 0 ? selectedToolNames.join(", ") : "None selected"}

For each of the ${numToGenerate} tool concept${numToGenerate > 1 ? "s" : ""}, provide:
1. Tool Name (clear, descriptive, action-oriented)
2. Tool Description (2-3 sentences explaining what the tool does and who it helps, written for a district leader audience)
3. Why This Fits (2 sentences connecting this tool to the stated challenge and audience)
4. Suggested Input Fields (3-6 fields the educator would fill in when using the tool, with brief descriptions)
5. Suggested Knowledge Files (2-4 types of documents to upload for context)
6. Expected Output (1-2 sentences describing what the tool produces)
7. Pilot Readiness Score (High/Medium/Low based on how easy this would be to build and test quickly)

Also identify which of the ${numToGenerate} tool${numToGenerate > 1 ? "s" : ""} should be the "Recommended First Pilot" and explain why in 2 sentences.${numToGenerate === 1 ? " Set isRecommendedPilot to true for it." : ""}

Respond ONLY in valid JSON with this exact structure (no markdown, no backticks, no preamble):
{
  "tools": [
    {
      "name": "",
      "description": "",
      "whyFits": "",
      "fields": [{"name": "", "description": ""}],
      "knowledgeFiles": [""],
      "expectedOutput": "",
      "pilotReadiness": "High|Medium|Low",
      "isRecommendedPilot": true|false
    }
  ],
  "pilotRationale": ""
}`;

    try {
      // --- GEMINI API CALL ---
      // Uses the provided execution environment apiKey and endpoint
      const apiKey = "";
      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }],
            generationConfig: { responseMimeType: "application/json" }
          }),
        }
      );
      const result = await response.json();
      const text = result.candidates?.[0]?.content?.parts?.[0]?.text || "";
      const clean = text.replace(/```json|```/g, "").trim();
      const parsed = JSON.parse(clean);

      // Append user-selected example tools as additional recommendation cards
      const userPickCards = selectedToolObjects.slice(0, 2).map(t => ({
        name: t.name,
        description: t.overview,
        whyFits: "You selected this tool as a close match for your challenge. It addresses a proven, repeatable workflow in this priority area.",
        fields: t.fields.split(", ").map(f => ({ name: f.trim(), description: "" })),
        knowledgeFiles: t.files.split(", ").map(f => f.trim()),
        expectedOutput: "See the full tool guide for detailed output examples.",
        pilotReadiness: "High",
        isRecommendedPilot: false,
        isUserPick: true,
      }));

      parsed.tools = [...parsed.tools, ...userPickCards];
      update("recommendations", parsed);
    } catch (err) {
      console.error(err);
      update("genError", "Something went wrong generating recommendations. Please try again.");
    } finally {
      update("isGenerating", false);
    }
  };

  const buildPlainTextSummary = () => {
    const priorityLabel = PRIORITY_AREAS.find(p => p.id === data.priority)?.label || "";
    const userLabels = data.users.map(uid => USER_ROLES.find(u => u.id === uid)?.label).filter(Boolean);
    const pilot = data.recommendations.tools.find(t => t.isRecommendedPilot);
    let txt = `SOLARA CUSTOM TOOL PLANNING SUMMARY\nGenerated ${new Date().toLocaleDateString()} | Panorama Education\n\n`;
    txt += `PLANNING CONTEXT\n`;
    txt += `Priority Area: ${priorityLabel}\n`;
    txt += `Challenge: ${data.challenge}\n`;
    txt += `Primary Audience: ${userLabels.join(", ")}\n`;
    txt += `Exemplars Available: ${data.hasExemplars ? "Yes" : "No"}${data.exemplarNotes ? ` (${data.exemplarNotes})` : ""}\n\n`;
    if (pilot) {
      txt += `RECOMMENDED FIRST PILOT: ${pilot.name}\n`;
      txt += `${data.recommendations.pilotRationale}\n\n`;
    }
    data.recommendations.tools.forEach((tool, i) => {
      const tag = tool.isRecommendedPilot ? " [RECOMMENDED PILOT]" : tool.isUserPick ? " [YOUR SELECTION]" : "";
      txt += `${"=".repeat(60)}\n`;
      txt += `${i + 1}. ${tool.name}${tag}\n`;
      txt += `${"=".repeat(60)}\n`;
      txt += `${tool.description}\n\n`;
      txt += `Why This Fits: ${tool.whyFits}\n`;
      txt += `Pilot Readiness: ${tool.pilotReadiness}\n`;
      txt += `Expected Output: ${tool.expectedOutput}\n\n`;
      txt += `Suggested Input Fields:\n`;
      tool.fields.forEach(f => { txt += `  - ${f.name}${f.description ? `: ${f.description}` : ""}\n`; });
      txt += `\nSuggested Knowledge Files:\n`;
      tool.knowledgeFiles.forEach(f => { txt += `  - ${f}\n`; });
      txt += `\n`;
    });
    txt += `---\nThis summary was generated using the Solara Custom Tool Idea Generator by Panorama Education.\nReview all recommendations with your implementation team before building.`;
    return txt;
  };

  const copyToClipboard = async () => {
    try {
      const text = buildPlainTextSummary();
      await navigator.clipboard.writeText(text);
      setCopySuccess(true);
      setTimeout(() => setCopySuccess(false), 3000);
    } catch (err) {
      const text = buildPlainTextSummary();
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      setCopySuccess(true);
      setTimeout(() => setCopySuccess(false), 3000);
    }
  };

  // ---- RENDER ----
  const containerStyle = { fontFamily: "'Segoe UI', Arial, Helvetica, sans-serif", minHeight: "100vh", background: "#F8F9FB", color: COLORS.darkGray };

  // Welcome
  if (step === -1) {
    return (
      <div style={containerStyle}>
        <div style={{ background: `linear-gradient(135deg, ${COLORS.navy} 0%, #2A2470 100%)`, padding: "48px 24px", textAlign: "center" }}>
          <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 12, marginBottom: 24 }}>
            <PanoramaLogo size={40} />
            <span style={{ color: COLORS.white, fontSize: 14, fontWeight: 700, letterSpacing: "0.08em", textTransform: "uppercase" }}>Panorama Education</span>
          </div>
          <h1 style={{ color: COLORS.white, fontSize: 32, fontWeight: 800, margin: "0 0 12px", lineHeight: 1.2 }}>Solara Custom Tool<br/>Idea Generator</h1>
          <p style={{ color: "#B8B5D0", fontSize: 17, maxWidth: 540, margin: "0 auto 32px", lineHeight: 1.6 }}>
            Move from "we could do anything" to "here's what we should do first." This guided experience helps your team identify high-value Solara Custom Tools aligned to your district's priorities.
          </p>
          <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 12, flexWrap: "wrap" }}>
            <Button onClick={() => setStep(0)} style={{ fontSize: 17, padding: "16px 40px" }}>Get Started</Button>
            <a href="https://sites.google.com/panoramaed.com/panorama-solara-tool-guide/home" target="_blank" rel="noopener noreferrer"
              style={{ padding: "14px 24px", borderRadius: 8, fontWeight: 700, fontSize: 15, border: "2px solid rgba(255,255,255,0.4)", color: COLORS.white, textDecoration: "none", transition: "all 0.2s ease", background: "rgba(255,255,255,0.08)" }}>Browse Example Tools ↗</a>
            <a href="https://academy.panoramaed.com/hc/en-us/articles/35310291425300-Creating-and-Managing-Custom-Tools" target="_blank" rel="noopener noreferrer"
              style={{ padding: "14px 24px", borderRadius: 8, fontWeight: 700, fontSize: 15, border: "2px solid rgba(255,255,255,0.4)", color: COLORS.white, textDecoration: "none", transition: "all 0.2s ease", background: "rgba(255,255,255,0.08)" }}>Custom Tool Setup Guide ↗</a>
          </div>
        </div>
        <div style={{ maxWidth: 700, margin: "0 auto", padding: "40px 24px" }}>
          <h2 style={{ color: COLORS.navy, fontSize: 20, fontWeight: 700, marginBottom: 20 }}>How it works</h2>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: 20 }}>
            {[
              { num: "1", title: "Pick a priority", desc: "Choose the strategic area where better workflows would have the most impact." },
              { num: "2", title: "Define the challenge", desc: "Get specific about the task, workflow, or pain point you want to solve." },
              { num: "3", title: "Identify who benefits", desc: "Clarify who would benefit most from the tool and who should pilot it first." },
              { num: "4", title: "Explore examples", desc: "Browse relevant tool examples and select the ones that match your vision." },
              { num: "5", title: "Get recommendations", desc: "Receive tailored tool concepts with specs you can use to start building." },
              { num: "6", title: "Export your plan", desc: "Download a summary to share with your team and guide next steps." },
            ].map(s => (
              <div key={s.num} style={{ background: COLORS.white, borderRadius: 10, padding: 20, border: "1px solid #E2E4E9" }}>
                <div style={{ width: 32, height: 32, borderRadius: "50%", background: COLORS.green, color: COLORS.white, display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, fontSize: 14, marginBottom: 10 }}>{s.num}</div>
                <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15, marginBottom: 4 }}>{s.title}</div>
                <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.5 }}>{s.desc}</div>
              </div>
            ))}
          </div>
          <div style={{ marginTop: 28 }}>
            <Tip>Custom Tools work best for repeatable, district-aligned workflows. This process will help you focus on use cases where consistency, time savings, and quality matter most.</Tip>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div style={containerStyle}>
      {/* Header */}
      <div style={{ background: COLORS.navy, padding: "14px 24px", display: "flex", alignItems: "center", gap: 10 }}>
        <PanoramaLogo size={28} />
        <span style={{ color: COLORS.white, fontSize: 15, fontWeight: 700, flex: 1 }}>Solara Custom Tool Idea Generator</span>
        <button onClick={() => { setStep(-1); setData({ priority: null, challenge: "", users: [], hasExemplars: null, exemplarNotes: "", selectedTools: [], noneMatch: false, recommendations: null, isGenerating: false, genError: null }); }}
          style={{ background: "rgba(255,255,255,0.12)", border: "1px solid rgba(255,255,255,0.25)", color: COLORS.white, padding: "6px 14px", borderRadius: 6, fontSize: 13, fontWeight: 600, cursor: "pointer", transition: "all 0.2s ease" }}
          onMouseEnter={e => e.target.style.background = "rgba(255,255,255,0.2)"}
          onMouseLeave={e => e.target.style.background = "rgba(255,255,255,0.12)"}
        >Home</button>
      </div>

      <div style={{ maxWidth: 760, margin: "0 auto", padding: "16px 24px 80px" }}>
        {step < 5 && <ProgressBar step={step} total={6} />}
