              outline: "none",
            }} onFocus={e => e.target.style.borderColor = COLORS.green} onBlur={e => e.target.style.borderColor = "#E2E4E9"} />
            <div style={{ fontSize: 12, color: "#9CA3AF", marginTop: 4 }}>{data.challenge.length} characters {data.challenge.trim().length < 20 ? "(minimum 20)" : "✓"}</div>
          </div>
        )}

        {/* STEP 2: Primary User */}
        {step === 2 && (
          <div>
            <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "8px 0 6px" }}>Who would benefit the most from this?</h2>
            <p style={{ color: "#6B7280", fontSize: 15, marginBottom: 8, lineHeight: 1.5 }}>Identify the educators who might use a tool designed to tackle this challenge.</p>
            <p style={{ color: COLORS.green, fontSize: 13, fontWeight: 600, marginBottom: 20 }}>{data.users.length} of 4 selected</p>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: 12 }}>
              {USER_ROLES.map(u => {
                const sel = data.users.includes(u.id);
                const atMax = data.users.length >= 4 && !sel;
                return (
                  <Card key={u.id} selected={sel} onClick={() => {
                    if (sel) { update("users", data.users.filter(x => x !== u.id)); }
                    else if (!atMax) { update("users", [...data.users, u.id]); }
                  }} style={{ opacity: atMax ? 0.5 : 1, cursor: atMax ? "default" : "pointer" }}>
                    <div style={{ display: "flex", alignItems: "start", justifyContent: "space-between", gap: 8 }}>
                      <div>
                        <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15, marginBottom: 4 }}>{u.label}</div>
                        <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.4 }}>{u.desc}</div>
                      </div>
                      <div style={{ width: 22, height: 22, borderRadius: 5, border: `2px solid ${sel ? COLORS.green : "#D1D5DB"}`, background: sel ? COLORS.green : "transparent",
                        display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0, marginTop: 2 }}>
                        {sel && <span style={{ color: COLORS.white, fontSize: 13, fontWeight: 800 }}>✓</span>}
                      </div>
                    </div>
                  </Card>
                );
              })}
            </div>
            <div style={{ marginTop: 20 }}>
              <Tip>The strongest pilots start with roles naturally aligned to the tool's purpose, like MTSS teams for intervention planning or instructional coaches for PD resources.</Tip>
            </div>
          </div>
        )}

        {/* STEP 3: Exemplars */}
        {step === 3 && (
          <div>
            <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "8px 0 6px" }}>Do you have examples of what "great" looks like?</h2>
            <p style={{ color: "#6B7280", fontSize: 15, marginBottom: 20, lineHeight: 1.5 }}>Templates, exemplars, or existing documents help shape a custom tool's output. They also serve as Knowledge files you can upload when building the tool in Solara.</p>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 20 }}>
              <Card selected={data.hasExemplars === true} onClick={() => update("hasExemplars", true)}>
                <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 16, marginBottom: 4 }}>Yes, we have some</div>
                <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.4 }}>We have templates, rubrics, exemplar documents, or existing formats we'd want to replicate.</div>
              </Card>
              <Card selected={data.hasExemplars === false} onClick={() => update("hasExemplars", false)}>
                <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 16, marginBottom: 4 }}>Not yet</div>
                <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.4 }}>We're starting from scratch or don't have a standardized format in place yet.</div>
              </Card>
            </div>
            {data.hasExemplars === true && (
              <div>
                <label style={{ fontSize: 14, fontWeight: 600, color: COLORS.navy, display: "block", marginBottom: 8 }}>Briefly describe what you have (optional)</label>
                <textarea value={data.exemplarNotes} onChange={e => update("exemplarNotes", e.target.value)} placeholder="e.g., We have a BIP template in Google Docs, a district attendance letter format, and sample SMART goals from last year..." style={{
                  width: "100%", minHeight: 80, padding: 14, borderRadius: 10, border: "2px solid #E2E4E9", fontSize: 14, lineHeight: 1.5, fontFamily: "inherit", resize: "vertical", boxSizing: "border-box", outline: "none",
                }} />
              </div>
            )}
            {data.hasExemplars === false && (
              <Tip>That's OK! Your recommendations will include suggestions for the types of documents to create or gather. These become the Knowledge files that make your custom tool smarter.</Tip>
            )}
          </div>
        )}

        {/* STEP 4: Example Tools */}
        {step === 4 && (
          <div>
            <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "8px 0 6px" }}>Which example tools are closest to what you need?</h2>
            <p style={{ color: "#6B7280", fontSize: 15, marginBottom: 8, lineHeight: 1.5 }}>Select one or more tools that align with your challenge. These will inform your recommendations.</p>
            <p style={{ color: COLORS.green, fontSize: 13, fontWeight: 600, marginBottom: 20 }}>{data.noneMatch ? "Skipping tool selection" : `${data.selectedTools.length} selected`}</p>

            {!data.noneMatch && (
              <>
                <div style={{ fontSize: 13, fontWeight: 700, color: COLORS.navy, textTransform: "uppercase", letterSpacing: "0.04em", marginBottom: 10 }}>
                  Recommended for {PRIORITY_AREAS.find(p => p.id === data.priority)?.label}
                </div>
                <div style={{ display: "grid", gap: 10, marginBottom: 24 }}>
                  {filteredTools.map(t => {
                    const sel = data.selectedTools.includes(t.id);
                    return (
                      <Card key={t.id} selected={sel} onClick={() => update("selectedTools", sel ? data.selectedTools.filter(x => x !== t.id) : [...data.selectedTools, t.id])}
                        style={{ display: "grid", gridTemplateColumns: "1fr auto", alignItems: "start", gap: 12 }}>
                        <div>
                          <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15, marginBottom: 4 }}>{t.name}</div>
                          <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.5 }}>{t.overview}</div>
                        </div>
                        <div style={{ width: 24, height: 24, borderRadius: 6, border: `2px solid ${sel ? COLORS.green : "#D1D5DB"}`, background: sel ? COLORS.green : "transparent",
                          display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0, marginTop: 2 }}>
                          {sel && <span style={{ color: COLORS.white, fontSize: 14, fontWeight: 800 }}>✓</span>}
                        </div>
                      </Card>
                    );
                  })}
                </div>

                {secondaryTools.length > 0 && (
                  <>
                    <div style={{ fontSize: 13, fontWeight: 700, color: "#9CA3AF", textTransform: "uppercase", letterSpacing: "0.04em", marginBottom: 10 }}>
                      Also relevant for your selected roles
                    </div>
                    <div style={{ display: "grid", gap: 10, marginBottom: 24 }}>
                      {secondaryTools.map(t => {
                        const sel = data.selectedTools.includes(t.id);
                        return (
                          <Card key={t.id} selected={sel} onClick={() => update("selectedTools", sel ? data.selectedTools.filter(x => x !== t.id) : [...data.selectedTools, t.id])}
                            style={{ display: "grid", gridTemplateColumns: "1fr auto", alignItems: "start", gap: 12 }}>
                            <div>
                              <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15, marginBottom: 4 }}>{t.name}</div>
                              <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.5 }}>{t.overview}</div>
                            </div>
                            <div style={{ width: 24, height: 24, borderRadius: 6, border: `2px solid ${sel ? COLORS.green : "#D1D5DB"}`, background: sel ? COLORS.green : "transparent",
                              display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0, marginTop: 2 }}>
                              {sel && <span style={{ color: COLORS.white, fontSize: 14, fontWeight: 800 }}>✓</span>}
                            </div>
                          </Card>
                        );
                      })}
                    </div>
                  </>
                )}
              </>
            )}

            {/* None of these match option */}
            <div style={{ borderTop: "1px solid #E2E4E9", paddingTop: 16 }}>
              <Card selected={data.noneMatch} onClick={() => {
                if (data.noneMatch) { update("noneMatch", false); }
                else { setData(d => ({ ...d, noneMatch: true, selectedTools: [] })); }
              }} style={{ background: data.noneMatch ? "#F0FBF4" : "#FAFAFA" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                  <div style={{ width: 24, height: 24, borderRadius: 6, border: `2px solid ${data.noneMatch ? COLORS.green : "#D1D5DB"}`, background: data.noneMatch ? COLORS.green : "transparent",
                    display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
                    {data.noneMatch && <span style={{ color: COLORS.white, fontSize: 14, fontWeight: 800 }}>✓</span>}
                  </div>
                  <div>
                    <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15 }}>None of these match what I need</div>
                    <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.4 }}>Skip this step. We'll generate all 3 recommendations based on your other inputs.</div>
                  </div>
                </div>
              </Card>
            </div>
          </div>
        )}

        {/* STEP 5: Recommendations */}
        {step === 5 && (
          <div ref={resultsRef}>
            {!data.recommendations && !data.isGenerating && !data.genError && (
              <div style={{ textAlign: "center", padding: "40px 0" }}>
                <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "0 0 12px" }}>Ready to generate your recommendations</h2>
                <p style={{ color: "#6B7280", fontSize: 15, maxWidth: 480, margin: "0 auto 24px", lineHeight: 1.5 }}>
                  Based on your selections, we'll generate 3 tailored Custom Tool concepts with detailed specs you can use to start building in Solara.
                </p>
                <div style={{ background: COLORS.white, borderRadius: 10, border: "1px solid #E2E4E9", padding: 20, maxWidth: 480, margin: "0 auto 24px", textAlign: "left" }}>
                  <div style={{ fontSize: 13, fontWeight: 700, color: COLORS.navy, marginBottom: 10 }}>YOUR SELECTIONS</div>
                  <div style={{ fontSize: 14, marginBottom: 6 }}><strong>Priority:</strong> {PRIORITY_AREAS.find(p => p.id === data.priority)?.label}</div>
                  <div style={{ fontSize: 14, marginBottom: 6 }}><strong>Audience:</strong> {data.users.map(uid => USER_ROLES.find(u => u.id === uid)?.label).filter(Boolean).join(", ")}</div>
                  <div style={{ fontSize: 14, marginBottom: 6 }}><strong>Challenge:</strong> {data.challenge.substring(0, 120)}{data.challenge.length > 120 ? "..." : ""}</div>
                  <div style={{ fontSize: 14 }}><strong>Example tools:</strong> {data.noneMatch ? "None selected (generating fresh ideas)" : `${data.selectedTools.length} selected`}</div>
                </div>
                <Button onClick={generateRecommendations} style={{ fontSize: 17, padding: "16px 40px" }}>Generate Recommendations</Button>
              </div>
            )}

            {data.isGenerating && (
              <div style={{ textAlign: "center", padding: "60px 0" }}>
                <div style={{ width: 48, height: 48, border: `4px solid ${COLORS.lightGray}`, borderTopColor: COLORS.green, borderRadius: "50%", margin: "0 auto 20px",
                  animation: "spin 1s linear infinite" }} />
                <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
                <h3 style={{ color: COLORS.navy, fontSize: 18, margin: "0 0 8px" }}>Generating your recommendations...</h3>
                <p style={{ color: "#9CA3AF", fontSize: 14 }}>Analyzing your inputs and building tailored tool specs.</p>
              </div>
            )}

            {data.genError && (
              <div style={{ textAlign: "center", padding: "40px 0" }}>
                <p style={{ color: "#DC2626", fontSize: 15, marginBottom: 16 }}>{data.genError}</p>
                <Button onClick={generateRecommendations}>Try Again</Button>
              </div>
            )}

            {data.recommendations && (
              <div id="printable-results">
                <ProgressBar step={5} total={6} />
                <StepLabel step={5} />
                <h2 style={{ color: COLORS.navy, fontSize: 22, fontWeight: 800, margin: "8px 0 6px" }}>Your Custom Tool Recommendations</h2>
                <p style={{ color: "#6B7280", fontSize: 15, marginBottom: 20, lineHeight: 1.5 }}>
                  Here are {data.recommendations.tools.length} tailored tool concepts based on your planning session. Each includes a spec sheet you can use to build the tool in Solara.
                </p>

                {/* Pilot callout */}
                {data.recommendations.pilotRationale && (
                  <div style={{ background: `linear-gradient(135deg, ${COLORS.navy}, #2A2470)`, borderRadius: 12, padding: 24, marginBottom: 24, color: COLORS.white }}>
