                  <div style={{ fontWeight: 700, color: COLORS.navy, fontSize: 15, marginBottom: 4 }}>{p.label}</div>
                  <div style={{ fontSize: 13, color: "#6B7280", lineHeight: 1.4 }}>{p.desc}</div>
